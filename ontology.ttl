@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix fabric: <https://fabric.microsoft.com/ontology/df3ab284-7783-4196-a652-95276c448a7d#>.

<https://fabric.microsoft.com/ontology/df3ab284-7783-4196-a652-95276c448a7d> a owl:Ontology;
                                                                             rdfs:label "InsurnaceOntlogy".
fabric:AMBestRating a owl:DatatypeProperty;
                    rdfs:domain fabric:Carrier;
                    rdfs:label "AMBestRating";
                    rdfs:range xsd:string.
fabric:Address a owl:DatatypeProperty;
               rdfs:domain fabric:Customer;
               rdfs:label "Address";
               rdfs:range xsd:string.
fabric:Agent a owl:Class;
             rdfs:label "Agent".
fabric:AgentID a owl:DatatypeProperty;
               rdfs:domain fabric:Agent;
               rdfs:label "AgentID";
               rdfs:range xsd:string.
fabric:AgentLocation a owl:DatatypeProperty;
