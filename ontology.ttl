                 rdfs:label "AgentName";
                 rdfs:range xsd:string.
fabric:Agent__AgentKey a owl:DatatypeProperty;
                       rdfs:domain fabric:Agent;
                       rdfs:label "AgentKey";
                       rdfs:range xsd:integer;
                       <urn:fabric-internal:qualifiedPropertyName> "true".
fabric:AnnualPremium a owl:DatatypeProperty;
                     rdfs:domain fabric:PolicySale;
                     rdfs:label "AnnualPremium";
                     rdfs:range xsd:double.
fabric:CalendarYear a owl:DatatypeProperty;
                    rdfs:domain fabric:Date;
                    rdfs:label "CalendarYear";
                    rdfs:range xsd:integer.
