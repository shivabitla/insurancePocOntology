                           rdfs:range xsd:integer;
                           <urn:fabric-internal:qualifiedPropertyName> "true".
fabric:CommissionAmount a owl:DatatypeProperty;
                        rdfs:domain fabric:PolicySale;
                        rdfs:label "CommissionAmount";
                        rdfs:range xsd:double.
fabric:CoverageAmount a owl:DatatypeProperty;
