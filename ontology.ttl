                             <urn:fabric-internal:qualifiedPropertyName> "true".
fabric:Date a owl:Class,
              owl:DatatypeProperty;
            rdfs:domain fabric:Date;
            rdfs:label "Date";
            rdfs:range xsd:dateTime.
fabric:DateKey a owl:DatatypeProperty;
               rdfs:domain fabric:Date;
               rdfs:label "DateKey";
               rdfs:range xsd:integer.
fabric:HeadquartersState a owl:DatatypeProperty;
